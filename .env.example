DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=merge
DB_CONNECTION_LIMIT=5

# 远端 Frappe（物流 / 需求单系统）：需求单同步与物料同步共用同一台服务，
# 地址与密钥只需在这里配一次，换 IP 或换密钥时只改这两行。
# 历史变量名 MATERIAL_API_BASE_URL / MATERIAL_API_TOKEN /
# FRAPPE_DEMAND_API_BASE_URL / FRAPPE_DEMAND_API_TOKEN 仍然兼容，但新部署请只用下面两个。
FRAPPE_API_BASE_URL=http://192.168.3.153:1337
FRAPPE_API_TOKEN=replace_with_frappe_token

# 同步分页与超时（可选，按服务单独配置）
MATERIAL_SYNC_PAGE_SIZE=100
MATERIAL_SYNC_TIMEOUT_MS=30000
FRAPPE_DEMAND_SYNC_PAGE_SIZE=200
FRAPPE_DEMAND_SYNC_TIMEOUT_MS=30000

# 需要建档的远端履约状态，逗号分隔。留空即默认口径：除取消外全部放开，
# 远端以后新增状态会自动进入同步范围；只有需要收窄成白名单时才填这一项。
FRAPPE_DEMAND_SYNC_STATUSES=
FRAPPE_DEMAND_CANCELLED_STATUSES=

# 远端 CRM（发票 / 回款 OpenAPI）：华为云业务的「账期发票（CRM）」页签用。
# 密钥在 CRM 平台个人中心生成；地址与密钥只在这里配一次。
CRM_API_BASE_URL=http://crm-api.wanzhongtech.com
CRM_API_TOKEN=replace_with_crm_openapi_token
# 业务线：1 云图 / 2 Cloud（华为云）/ 3 vibe，默认 2
CRM_BUSINESS_LINE_ID=2
# 手动/定时同步默认同步最近多少个月（含当月），默认 3
CRM_SYNC_MONTHS=3
# 可选：接口超时毫秒，默认 30000
CRM_TIMEOUT_MS=30000

# 华为 OBS（文件存储）：填了密钥即启用，文件存到对象存储，数据库只留索引。
# 目录规范：Cloud/算力/<国家码>/<需求单号>、Cloud/集采/<项目>、Cloud/华为云/<客户>/<年月>、Cloud/文档库/<文件夹>
OBS_ENDPOINT=obs.cn-east-2.myhuaweicloud.com
OBS_REGION=cn-east-2
OBS_BUCKET=ad-data-platform
# 桶 ad-data-platform 里的目录前缀，必须小写 cloud（大小写敏感，写成 Cloud 会被桶策略拒绝）
OBS_PREFIX=cloud
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
# 显式关掉（=0）时全部回落到"文件存数据库"，用于灰度回滚
OBS_ENABLED=1
# 可选：单次请求超时毫秒，默认 30000
OBS_TIMEOUT_MS=30000

AUTH_SESSION_TOKEN=replace_with_random_token
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace_with_strong_password
OPERATION_LOG_RETENTION_DAYS=365

# 飞书登录（自建应用）。在飞书开放平台建应用 → 开启「网页应用」→
# 把「重定向 URL」配置成 {站点地址}/api/auth/feishu/callback。
# 不配置 APP_ID / APP_SECRET 时，登录页的飞书按钮为禁用状态，仅保留管理员密码登录。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：回调地址覆盖（默认按请求来源推导，本地/生产都不用改）
FEISHU_REDIRECT_URI=
# 可选：=1 时公司成员首次飞书登录自动建号（默认关闭，只有管理员已建的账号才能登录）
FEISHU_AUTO_PROVISION=0
# 可选：自动建号时新员工的默认权限 full / readonly / none
# 默认 full：除「账户管理」「功能启用」外，其余模块的查看/新增/修改/删除/导入/导出/确认全部开启；
# 这两个管理员模块不授任何权限，必须由管理员在用户管理里单独开启。
FEISHU_AUTO_PROVISION_PERMISSIONS=full
# 可选：限定只允许本公司租户登录（填飞书租户 key）
FEISHU_TENANT_KEY=
# 可选：Lark 国际版改成 https://open.larksuite.com
FEISHU_API_BASE=https://open.feishu.cn
